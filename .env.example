# Digital Khata Environment Variables Configuration
# Copy this file to .env and fill in your actual credentials for local development & Vercel deployment.

# ------------------------------------
# SUPABASE CONFIGURATION (Cloud DB & Auth)
# ------------------------------------
# Find these in Supabase Dashboard -> Project Settings -> API
SUPABASE_URL=https://your-supabase-project-id.supabase.co
SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.your-anon-key-here
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.your-service-role-key-here

# ------------------------------------
# TWILIO SMS CONFIGURATION (Real 6-Digit SMS OTP)
# ------------------------------------
# Find these in Twilio Console -> Account Info
TWILIO_ACCOUNT_SID=ACXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX
TWILIO_AUTH_TOKEN=your_twilio_auth_token_here
TWILIO_PHONE_NUMBER=+12345678901

# Optional: Demo/Test Mode flag (Set to 'true' to log OTP in Vercel console during testing if Twilio credits are low)
DEMO_OTP_MODE=false
